# Copy to .env.local for local work, and add the SAME names in Vercel -> Settings -> Environment Variables.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=            # SECRET - server only, never commit

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://your-domain.com   # no trailing slash; used for Easebuzz return URLs

# --- Easebuzz (leave EASEBUZZ_KEY empty to keep the demo checkout) ---
EASEBUZZ_KEY=                         # Merchant Key from the Easebuzz dashboard
EASEBUZZ_SALT=                        # SECRET - server only, never commit
EASEBUZZ_ENV=test                     # "test" (testpay.easebuzz.in) or "prod" (pay.easebuzz.in)

# --- Optional: other payment providers / admin webhooks ---
FULFILL_WEBHOOK_SECRET=               # long random string for /api/checkout/fulfill
